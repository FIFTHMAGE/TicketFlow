# StableFlow Marketplace Settlement Configuration
# Copy this file to .env and fill in all required values before running locally or deploying.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # Change to 'production' on Vercel

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. your Vercel deployment URL)
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Leave blank for SQLite (local dev). Set to Supabase connection string for production.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=

# ── Admin JWT ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — must be a long random string (≥ 32 chars)
ADMIN_JWT_SECRET=CHANGE_ME_BEFORE_DEPLOYING

# ── Basqet (Crypto Payments) ──────────────────────────────────────────────────
# Get from your Basqet dashboard (https://dashboard.basqet.com)
BASQET_PRIVATE_KEY=
BASQET_API_URL=https://api.basqet.com
# REQUIRED IN PRODUCTION — must match the secret set in your Basqet webhook settings
BASQET_WEBHOOK_SECRET=CHANGE_ME_BEFORE_DEPLOYING

# ── Nomba (Fiat Payouts) ─────────────────────────────────────────────────────
# Get from https://developer.nomba.com
NOMBA_CLIENT_ID=
NOMBA_CLIENT_SECRET=
NOMBA_ACCOUNT_ID=
# REQUIRED IN PRODUCTION — must match the secret set in your Nomba webhook settings
NOMBA_WEBHOOK_SECRET=CHANGE_ME_BEFORE_DEPLOYING

# ── Email / Ticket Delivery ───────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address (must be a verified domain in Resend)
FROM_EMAIL=tickets@yourdomain.com
