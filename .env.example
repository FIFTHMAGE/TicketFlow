# StableFlow Marketplace Settlement Configuration
# Copy this file to .env and fill in all required values before running locally or deploying.

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development   # Change to 'production' on Vercel

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (e.g. your Vercel deployment URL)
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ─────────────────────────────────────────────────────────────────
# Connect using a single URL OR using individual parameters below
DATABASE_URL=

# Fallback parameters (avoids password special character parsing errors)
DB_HOST=
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=

# ── Admin JWT ────────────────────────────────────────────────────────────────
# REQUIRED IN PRODUCTION — must be a long random string (≥ 32 chars)
ADMIN_JWT_SECRET=CHANGE_ME_BEFORE_DEPLOYING

# ── Basqet (Crypto Payments) ──────────────────────────────────────────────────
# Get from your Basqet dashboard (https://dashboard.basqet.com)
BASQET_PRIVATE_KEY=
BASQET_API_URL=https://api.basqet.com
# REQUIRED IN PRODUCTION — must match the secret set in your Basqet webhook settings
BASQET_WEBHOOK_SECRET=CHANGE_ME_BEFORE_DEPLOYING

# ── Flutterwave v4 (OAuth2 & Account Resolution) ──────────────────────────
# Get from https://dashboard.flutterwave.com/settings/apis (or v4 Identity Provider)
FLW_CLIENT_ID=
FLW_CLIENT_SECRET=
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
FLW_V4_BASE_URL=https://developersandbox-api.flutterwave.com
# REQUIRED IN PRODUCTION — secret hash set in your Flutterwave Webhooks settings
FLW_SECRET_HASH=CHANGE_ME_BEFORE_DEPLOYING

# ── Email / Ticket Delivery ───────────────────────────────────────────────────
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=
# The "from" address (use onboarding@resend.dev if domain is not yet verified)
FROM_EMAIL=onboarding@resend.dev
