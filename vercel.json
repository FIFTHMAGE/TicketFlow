{
  "version": 2,
  "builds": [
    {
      "src": "backend/server.js",
      "use": "@vercel/node"
    }
  ],
  "rewrites": [
    {
      "source": "/api-v1/:path*",
      "destination": "/backend/server.js"
    },
    {
      "source": "/api/:path*",
      "destination": "/backend/server.js"
    },
    {
      "source": "/admin/:path*",
      "destination": "/backend/server.js"
    },
    {
      "source": "/portal/:path*",
      "destination": "/backend/server.js"
    }
  ]
}
