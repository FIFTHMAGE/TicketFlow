{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/backend/server.js"
    },
    {
      "source": "/((?!api|admin).*)" ,
      "destination": "/backend/server.js"
    }
  ]
}
